# local_settings.py — generado por Ansible (observer_api role)
# NO editar manualmente — los cambios se perderán en el próximo deploy

SECRET_KEY = "{{ vault_django_secret_key }}"

# URL ofuscada del admin Django (= install.sh ADMIN_URL). settings.py solo la define
# en el bloque GHACTIONS; en producción DEBE venir de aquí o middleware.py falla con
# AttributeError 'ADMIN_URL'. Incluye '/' final como el install.sh (línea 493).
ADMIN_URL = "{{ observer_admin_url }}/"

DATABASES = {
    'default': {
        'ENGINE': 'django.db.backends.postgresql',
        'NAME': '{{ observer_db_name }}',
        'USER': '{{ observer_db_user }}',
        'PASSWORD': '{{ vault_observer_db_password }}',
        'HOST': '{{ observer_db_host }}',
        'PORT': '{{ observer_db_port | default("5432") }}',
    }
}

# sslmode del cliente nats-api (Go/lib/pq) → PostgreSQL, leído por create_natsapi_conf.
# lib/pq NO soporta 'prefer'; 'require' cifra sin verificar CA (correcto con el snakeoil de
# observer_db, ssl=on). Cierra el residual O-DIFF-PGAUTH (el default del comando era 'disable').
# Django no usa DB_SSL: negocia TLS por el default de libpq (prefer) por su cuenta.
DB_SSL = "{{ observer_db_sslmode | default('require') }}"

REDIS_HOST = '{{ observer_redis_host }}'
REDIS_PORT = {{ observer_redis_port | default(6379) }}
# (sin REDIS_PASSWORD: el backend no soporta auth Redis — channels, cache y
# celery usan redis://HOST:6379 sin password, igual que upstream/install.sh)

MESH_SITE = 'https://{{ observer_mesh_domain }}'
MESH_USERNAME = '{{ observer_mesh_user | default("meshcentral_admin") }}'
# MESH_TOKEN_KEY NO es la contraseña del admin: es el login token key (hex >=160) que
# MeshCentral guarda como LoginCookieEncryptionKey en su DB. El rol observer_mesh lo
# obtiene con `--logintokenkey` y lo publica como fact (cierra GAP-049 — antes apuntaba a
# vault_observer_mesh_password, no-hex → ValueError en meshctrl.get_auth_token/bytes.fromhex).
# El play observer_mesh SIEMPRE corre antes que observer_api en install.yml, así que el fact existe.
MESH_TOKEN_KEY = '{{ hostvars[groups["observer_mesh"][0]]["observer_mesh_login_token_key"] }}'

NATS_SERVER = 'nats://{{ observer_nats_host }}:{{ observer_nats_port }}'

# Parámetros de escala anti-OOM — validados en producción (~28k agentes).
# Bloque COMPLETO parametrizado (F009): los 8 CHECKIN_* + CHECK_INTERVAL_JITTER +
# NATS_MAX_CONNECTIONS. Nombres = los que lee apiv3/utils.py. Defaults del rol =
# valores de producción; bajar cualquiera (esp. SYNCMESH < 3600) arriesga OOM MeshCentral.
CHECKIN_HELLO = ({{ observer_checkin_hello_min }}, {{ observer_checkin_hello_max }})
CHECKIN_AGENTINFO = ({{ observer_checkin_agentinfo_min }}, {{ observer_checkin_agentinfo_max }})
CHECKIN_WINSVC = ({{ observer_checkin_win_services_min }}, {{ observer_checkin_win_services_max }})
CHECKIN_PUBIP = ({{ observer_checkin_pubip_min }}, {{ observer_checkin_pubip_max }})
CHECKIN_DISKS = ({{ observer_checkin_disks_min }}, {{ observer_checkin_disks_max }})
CHECKIN_SW = ({{ observer_checkin_sw_inventory_min }}, {{ observer_checkin_sw_inventory_max }})
CHECKIN_WMI = ({{ observer_checkin_hw_assets_min }}, {{ observer_checkin_hw_assets_max }})
CHECKIN_SYNCMESH = ({{ observer_checkin_syncmesh_min }}, {{ observer_checkin_syncmesh_max }})
CHECK_INTERVAL_JITTER = ({{ observer_check_interval_jitter_min }}, {{ observer_check_interval_jitter_max }})
CHECKIN_GEO = ({{ observer_checkin_geo_min }}, {{ observer_checkin_geo_max }})
NATS_MAX_CONNECTIONS = {{ observer_nats_max_connections }}

# Feature 023/026 — resolución WiFi→coordenadas (/api/v3/geolocate/, modelo Prey).
# La key vive SOLO acá, en el backend, nunca en la flota, y NO se versiona: viene del
# vault del ambiente (vault_google_geolocation_api_key). Si está vacía no se emite la
# línea y settings.py deja la resolución WiFi apagada → el agente degrada a IP.
# Este bloque existe porque este archivo se RE-RENDERIZA en cada install.yml: una key
# puesta a mano acá se perdería en el próximo deploy, en silencio.
{% if observer_google_geolocation_api_key | default('') | length > 0 %}
GOOGLE_GEOLOCATION_API_KEY = '{{ observer_google_geolocation_api_key }}'
{% endif %}

# Versión del agente que ESTE ambiente ofrece a la flota. Si la variable está vacía no se
# emite la línea y manda el LATEST_AGENT_VER de settings.py (la del producto). Permite que
# un ambiente vaya adelante (staging probando un release) o quede congelado atrás sin
# tocar el código. get_agent_url() arma la ruta del CDN con este valor: publicar el binario
# no mueve a nadie, moverlos es cambiar esta variable. Vive acá y NO a mano en el servidor
# porque este archivo se RE-RENDERIZA en cada install.yml — un parche manual se perdería
# en silencio y la flota caería a la versión del producto (pasó con 2.14.4 → 2.14.3).
{% if observer_latest_agent_ver | default('') | length > 0 %}
LATEST_AGENT_VER = "{{ observer_latest_agent_ver }}"
{% endif %}

# TLS: Observer usa el modelo de certs distribuido en /etc/ssl/observer/ (ADR TLS
# distribuido: modos acme|byo dejan ambos el cert ahí; "path único"), NO la ruta
# estándar /etc/letsencrypt/live/<domain>/. Sin CERT_FILE/KEY_FILE, get_certs()
# (helpers.py) cae al default letsencrypt inexistente y days_until_cert_expires()
# lanza FileNotFoundError. Eso rompe TODO consumidor de get_certs: el consumer
# DashInfo deja el CONTEO DE AGENTES en 0 (el payload agentcount nunca se envía),
# los endpoints core de expiración de cert fallan, y get_config revienta. GAP-059.
CERT_FILE = "{{ observer_cert_path | default('/etc/ssl/observer/fullchain.pem') }}"
KEY_FILE = "{{ observer_cert_key_path | default('/etc/ssl/observer/privkey.pem') }}"

ALLOWED_HOSTS = ['{{ observer_domain | default("*") }}']

CORS_ORIGIN_WHITELIST = [
    'https://{{ observer_app_domain | default(observer_domain | default("localhost")) }}',
{% if observer_debug | default(false) %}
    'http://localhost:9000',
{% endif %}
]
