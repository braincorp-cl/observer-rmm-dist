CELERYD_NODES="w1"
CELERY_BIN="{{ observer_root }}/api/env/bin/celery"
CELERY_APP="{{ observer_app_name }}"
CELERYD_MULTI="multi"
# Limite blando/duro por tarea (s). Medido 17-24 nov 2026: la tarea legitima mas larga
# a escala de 22.000 agentes dura 29 min; con el blando, un cuelgue suelta su lock a las 2 h.
CELERYD_OPTS="--soft-time-limit={{ celery_soft_time_limit | default(7200) }} --time-limit={{ celery_time_limit | default(7500) }} --autoscale={{ celery_max_workers | default(20) }},{{ celery_min_workers | default(2) }}"
CELERYD_PID_FILE="{{ observer_root }}/api/{{ observer_app_name }}/%n.pid"
CELERYD_LOG_FILE="/var/log/celery/%n%I.log"
CELERYD_LOG_LEVEL="ERROR"
CELERYBEAT_PID_FILE="{{ observer_root }}/api/{{ observer_app_name }}/beat.pid"
CELERYBEAT_LOG_FILE="/var/log/celery/beat.log"
