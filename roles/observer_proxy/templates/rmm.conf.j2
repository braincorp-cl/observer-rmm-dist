upstream rmm-backend {
    server unix:{{ observer_root }}/api/{{ observer_app_name }}/observerrmm.sock fail_timeout=0;
}

upstream rmm-asgi {
    server unix:{{ observer_root }}/daphne.sock fail_timeout=0;
}

upstream rmm-natsws {
    server {{ hostvars[groups['observer_api'][0]]['ansible_host'] | default('127.0.0.1') }}:{{ observer_nats_ws_port | default(9235) }};
}

server {
    listen {{ observer_proxy_http_port }};
    server_name {{ observer_domain }};
    return 301 https://$host$request_uri;
}

server {
    listen {{ observer_proxy_https_port }} ssl;
    server_name {{ observer_domain }};

    ssl_certificate     {{ observer_cert_path }};
    ssl_certificate_key {{ observer_cert_key_path }};
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    client_max_body_size 300M;

    # Estáticos de Django (admin + DRF browsable API). Sin esta location, con
    # DEBUG=False y sin whitenoise, daban 404 pese a que collectstatic los deja en
    # STATIC_ROOT (= BASE_DIR/static). El SPA Vue no usa /static/. Espejo de prod.
    location /static/ {
        alias {{ observer_root }}/api/{{ observer_app_name }}/static/;
        add_header "Access-Control-Allow-Origin" "https://{{ observer_app_domain }}";
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Assets de reportes servidos vía X-Accel-Redirect desde ee/reporting
    # (NginxRedirect → "/assets/" + asset.file.name). Sin esta location interna las
    # descargas de assets de reportes dan 404. Paridad con prod; alias =
    # REPORTING_ASSETS_BASE_PATH del backend Django.
    location /assets/ {
        internal;
        add_header "Access-Control-Allow-Origin" "https://{{ observer_app_domain }}";
        alias {{ observer_reporting_assets_path }}/;
    }

    location /ws/ {
        proxy_pass http://rmm-asgi;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400;
    }

    location /natsws {
        proxy_pass http://rmm-natsws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    location / {
        uwsgi_pass rmm-backend;
        include /etc/nginx/uwsgi_params;
        uwsgi_read_timeout 9999;
        uwsgi_ignore_client_abort on;
    }
}
