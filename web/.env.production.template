# .env.production — Configuración de build para producción
# Renombrar a .env.production y reemplazar los placeholders antes del build.
# Este archivo NO debe subirse al repositorio (.gitignore lo excluye).
#
# observer_domain  = dominio de la API  (ej. api.serviciosmds.cl)
# observer_app_domain = dominio del frontend (ej. rmm.serviciosmds.cl)

VITE_API_BASE_URL=https://OBSERVER_DOMAIN_PLACEHOLDER
VITE_WS_URL=wss://OBSERVER_DOMAIN_PLACEHOLDER/ws/
VITE_APP_VERSION=0.0.1-observer
VITE_APP_NAME=Observer RMM
