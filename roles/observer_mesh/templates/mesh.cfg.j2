{
  "settings": {
    "cert": "{{ observer_mesh_domain }}",
    "WANonly": true,
    "minify": 1,
    "port": {{ observer_mesh_port | default(4430) }},
    "aliasPort": 443,
    "redirPort": 800,
    "allowLoginToken": true,
    "allowFraming": true,
    "agentPing": 250,
    "agentIdleTimeout": 300,
    "agentWsCompression": true,
    "wsCompression": true,
    "compression": true,
    "allowHighQualityDesktop": true,
    "tlsOffload": "{{ hostvars[groups['observer_proxy'][0]]['ansible_host'] | default('127.0.0.1') }}",
    "cookieEncoding": "base64",
    "agentsInRam": true,
    "allowedFramingOrigins": [
      "https://{{ observer_app_domain }}"
    ],
    "ignoreAgentHashCheck": true,
    "_autoBackup_comment": "DESACTIVADO a propósito: el autobackup nativo zipea todo el árbol de MeshCentral, que CONTIENE meshcentral-backups -> incluye sus propios backups previos recursivamente (133M -> 82G -> disco lleno). El guard anti-recursión de MeshCentral (meshcentral.js:2100) solo cubre backuppath dentro de datapath, no dentro del scope del zip. autoBackup:false -> MeshCentral lo elimina (meshcentral.js:2093). Los respaldos de mesh (DB + dir) los hace el rol observer_backup (GAP-038), sin redundancia.",
    "autoBackup": false,
    "prometheus": true,
    "dbExpire": {
      "events": {{ (observer_mesh_events_keep_days | int) * 86400 }},
      "powerevents": {{ (observer_mesh_powerevents_keep_days | int) * 86400 }},
      "statsevents": {{ (observer_mesh_statsevents_keep_days | int) * 86400 }}
    },
    "maxInvalidLogin": {
      "time": 5,
      "count": 5,
      "coolofftime": 30
    },
    "postgres": {
      "user": "{{ observer_mesh_db_user }}",
      "password": "{{ vault_observer_mesh_db_password }}",
      "port": "{{ observer_db_port | default(5432) }}",
      "host": "{{ observer_db_host | default('localhost') }}"
    }
  },
  "domains": {
    "": {
      "title": "Observer RMM",
      "title2": "Observer RMM",
      "newAccounts": false,
      "certUrl": "https://{{ observer_mesh_domain }}:443/",
      "geoLocation": true,
      "cookieIpCheck": false,
      "mstsc": true
    }
  }
}
