# /etc/nginx/nginx.conf — generado por Ansible (observer_proxy). Espejo del install.sh
# (líneas 282-306): el paquete nginx.org NO incluye sites-enabled/ por defecto, así que
# se reemplaza nginx.conf para incluir conf.d/*.conf Y sites-enabled/* (donde el rol
# despliega rmm/frontend/meshcentral).
worker_rlimit_nofile 1000000;
user www-data;
worker_processes auto;
pid /run/nginx.pid;
include /etc/nginx/modules-enabled/*.conf;

events {
    worker_connections 4096;
}

http {
    sendfile on;
    tcp_nopush on;
    types_hash_max_size 2048;
    server_names_hash_bucket_size 256;
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;
{% if observer_trusted_proxy_ip %}

    # --- real_ip: IP real del cliente tras un proxy reverso corporativo (ej. NPM).
    # Se declara en http → lo heredan los 3 vhosts (rmm/frontend/mesh). Solo se confía en
    # la(s) IP(s) del proxy; con real_ip_recursive nginx recorre X-Forwarded-For de derecha
    # a izquierda saltando saltos confiables y se queda con la primera IP NO confiable = el
    # cliente real → un X-Forwarded-For spoofeado por el cliente se ignora. Reescribe
    # $remote_addr, así REMOTE_ADDR llega correcto a uWSGI/daphne y a todo Django.
{% for _ip in ([observer_trusted_proxy_ip] if observer_trusted_proxy_ip is string else observer_trusted_proxy_ip) %}
    set_real_ip_from {{ _ip }};
{% endfor %}
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
{% endif %}

    # gzip — sin gzip_types solo comprime text/html; el bundle JS de Quasar (~3.5MB)
    # se serviría sin comprimir. Bloque portado de la config de producción.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 4;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/javascript
        application/x-javascript
        application/json
        application/xml
        application/rss+xml
        image/svg+xml
        font/woff
        font/woff2;

    include /etc/nginx/conf.d/*.conf;
    include /etc/nginx/sites-enabled/*;
}
