{
  "settings": {
    "cert": "{{ observer_mesh_domain }}",
    "WANonly": true,
    "minify": 1,
    "port": {{ observer_mesh_port | default(4430) }},
    "aliasPort": 443,
    "redirPort": 800,
    "allowLoginToken": true,
    "allowFraming": true,
    "agentPing": 250,
    "agentIdleTimeout": 300,
    "agentWsCompression": true,
    "wsCompression": true,
    "compression": true,
    "allowHighQualityDesktop": true,
    "tlsOffload": "{{ hostvars[groups['observer_proxy'][0]]['ansible_host'] | default('127.0.0.1') }}",
    "cookieEncoding": "base64",
    "agentsInRam": true,
    "allowedFramingOrigins": [
      "https://{{ observer_app_domain }}"
    ],
{#
  ignoreAgentHashCheck: variable observer_mesh_ignore_agent_hash_check (default false).
  false = pin ESTRICTO del hash de cert del agente (correcto solo en single-proxy: el
  agente ve el mismo cert LE que MeshCentral fija tras tlsOffload+nginx local).
  true = necesario cuando un reverse-proxy RE-ENCRIPTA delante del mesh (NPM corporativo
  double-proxy): el agente ve el cert LE del NPM, cuyo hash NO calza con el cert interno
  -> "Agent bad web cert hash ... holding connection" -> el nodo nunca registra y "Tomar
  control" no funciona. En true el TLS igual se valida (cadena LE); solo se omite el pin
  del hash exacto. tier1 (PROD) Y staging quedan tras el NPM double-proxy (incluso por
  LAN) -> AMBOS lo activan en su inventario. Verificado 2026-07-22 (PROD: nodo TESLADRP
  registró tras el cambio; staging: 7 nodos reconectaron, 0 rechazos). NO global.
#}
    "ignoreAgentHashCheck": {{ observer_mesh_ignore_agent_hash_check | to_json }},
{#
  autoBackup nativo de MeshCentral.
  DESACTIVADO (observer_mesh_autobackup_enabled=false) al CIERRE DEL PROYECTO 2026-07-03,
  tras validar el autobackup en staging (zips diarios con pgdump + meshcentral-data, retención
  y horario OK). observer_backup (GAP-038, cron diario) ya respalda DB mesh (pg_dump) +
  meshcentral-data (certs/config) sin node_modules; el nativo es redundante.
  Anti-recursión: se omite backupPath a propósito -> usa el default "meshcentral-backups",
  que queda HERMANO de meshcentral-data (fuera del dataPath), igual que producción. Esto
  SOLO es seguro mientras el servicio NO pase --dataPath /meshcentral (ver
  meshcentral.service.j2): con el dataPath por defecto el backup no se incluye a sí mismo.
#}
{% if observer_mesh_autobackup_enabled | bool %}
    "autoBackup": {
      "keepLastDaysBackup": {{ observer_mesh_autobackup_keep_days | int }},
      "backupHour": {{ observer_mesh_autobackup_hour | int }}
    },
{% else %}
    "autoBackup": false,
{% endif %}
    "prometheus": true,
    "dbExpire": {
      "events": {{ (observer_mesh_events_keep_days | int) * 86400 }},
      "powerevents": {{ (observer_mesh_powerevents_keep_days | int) * 86400 }},
      "statsevents": {{ (observer_mesh_statsevents_keep_days | int) * 86400 }}
    },
    "maxInvalidLogin": {
      "time": 5,
      "count": 5,
      "coolofftime": 30
    },
    "postgres": {
      "user": "{{ observer_mesh_db_user }}",
      "password": "{{ vault_observer_mesh_db_password }}",
      "port": "{{ observer_db_port | default(5432) }}",
      "host": "{{ observer_db_host | default('localhost') }}"
    }
  },
  "domains": {
    "": {
      "title": "Observer RMM",
      "title2": "Observer RMM",
      "newAccounts": false,
      "certUrl": "https://{{ observer_mesh_domain }}:443/",
      "geoLocation": true,
      "cookieIpCheck": false,
      "mstsc": true
    }
  }
}
