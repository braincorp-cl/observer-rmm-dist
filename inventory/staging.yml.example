---
# Plantilla de inventario STAGING — all-in-one sobre un solo host vía SSH.
# Topología co-localizada (los 5 grupos apuntan al mismo host, como all-in-one.yml);
# entre sí los servicios se hablan por loopback DENTRO del host.
#
# USO: copiar a inventory/staging.yml y reemplazar los valores marcados.
#      El archivo real (inventory/staging.yml) está en .gitignore — NO se versiona
#      porque contiene la IP del lab y el admin_url ofuscado del ambiente.
#
# Mismo patrón que la guía de producción del README (host-vars de topología + HugePages
# vía grub); solo cambia el sizing, dimensionado a una VM chica.
all:
  vars:
    ansible_user: observer
    ansible_python_interpreter: /usr/bin/python3
    # TLS: wildcard *.<base_domain> emitido por acme.sh vía API DNS de GoDaddy (dns_gd),
    # automatizado dentro del playbook (sin paso manual). Requiere vault_godaddy_key/secret
    # en group_vars/observer_proxy/vault.yml. Certs en /etc/ssl/observer/, renovación por cron.
    observer_cert_mode: acme
    observer_acme_email: ops@example.com        # ← email de registro ACME/Let's Encrypt
    # Dominios (install.sh: rmmdomain / frontenddomain / meshdomain / rootdomain):
    observer_domain: api.example.cl             # backend/API — ALLOWED_HOSTS, rmm.conf
    observer_app_domain: rmm.example.cl         # frontend/web UI — frontend.conf, CORS
    observer_mesh_domain: mesh.example.cl       # mesh — meshcentral.conf
    observer_base_domain: example.cl            # dominio raíz para el wildcard *.example.cl
    # URL ofuscada del admin Django (random ~70 chars, como install.sh). Estable por
    # ambiente y única por instalación → definir en un vault, NUNCA en claro aquí.
    observer_admin_url: "{{ vault_admin_url }}" # ← definir en group_vars/observer_api/vault.yml
    # Versión del agente que este ambiente OFRECE a la flota. Comentada = manda la del
    # producto (LATEST_AGENT_VER de settings.py). Descoméntela para adelantar un ambiente
    # (probar un release en una flota chica) o para congelarlo atrás. Publicar el binario
    # al CDN NO mueve a nadie: get_agent_url() arma la ruta con este valor, así que el CDN
    # es el depósito y esta variable es el interruptor. Debe ir aquí y no a mano en el
    # servidor: local_settings.py se RE-RENDERIZA en cada install.yml.
    # observer_latest_agent_ver: "2.15.2"   # ej.: lo que ofrece staging al 2026-08-07
    #
    # 🪤 Esta variable NO basta por sí sola para mover un ambiente ya instalado:
    # `deploy-api.yml` NO renderiza `local_settings.py` (lo dice en su cabecera), así que
    # cambiarla acá sólo surte efecto en un `install.yml`. Para un bump sobre un ambiente
    # vivo hay que editar `local_settings.py` en el servidor y reiniciar rmm/daphne/
    # celery/celerybeat — y dejar esta línea al día para que un install.yml futuro
    # renderice lo mismo y no revierta el cambio. (Aprendizaje del 2026-08-07.)
    # Tuning PostgreSQL para una VM all-in-one chica (~4 GB; los defaults del rol son
    # de prod dedicado: 4GB shared_buffers > RAM total). El sizing dependiente de RAM va
    # AQUÍ (en el inventario), NO en group_vars. Ajustar a la VM.
    pg_shared_buffers: "256MB"
    pg_effective_cache_size: "1GB"
    pg_maintenance_work_mem: "64MB"
    pg_autovacuum_work_mem: "64MB"
    pg_min_wal_size: "128MB"
    pg_max_wal_size: "1GB"
    observer_db_max_connections: 100
    # HugePages: el rol DERIVA nr_hugepages de shared_buffers (256MB → ~167 páginas/334MB)
    # y las reserva en dos capas — sysctl (runtime, sin reboot) + grub (boot-time, robusto).
    # NO fije pg_vm_nr_hugepages a mano. Tras el primer deploy REINICIE el host para que la
    # reserva boot-time quede firme. Para NO usar HugePages: pg_huge_pages: "off".
    pg_huge_pages: "try"
  children:
    # En All-in-One los 5 grupos apuntan al MISMO host. La topología de conexión (todo por
    # loopback) va como HOST-VARS de 'staging', NO en all.vars: así le gana en precedencia
    # a la expresión dinámica multi-host de los group_vars. Si fuera en all.vars, group_vars
    # la pisaría y observer_db_host resolvería a la IP del host → rompería la conexión
    # (pg_hba solo permite loopback).
    observer_db:
      hosts:
        staging:
          ansible_host: 10.20.0.10              # ← IP real del host de staging (reemplazar)
          observer_db_host: localhost
          observer_redis_host: localhost
          observer_mesh_host: localhost
          observer_nats_host: 127.0.0.1
    observer_redis:
      hosts: { staging: { ansible_host: 10.20.0.10 } }
    observer_mesh:
      hosts: { staging: { ansible_host: 10.20.0.10 } }
    observer_api:
      hosts: { staging: { ansible_host: 10.20.0.10 } }
    observer_proxy:
      hosts: { staging: { ansible_host: 10.20.0.10 } }
