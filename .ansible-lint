---
profile: moderate
exclude_paths:
  - molecule/
  - .cache/
warn_list:
  - yaml[line-length]
  - name[casing]
skip_list:
  - fqcn[action-core]
  # El proyecto usa el prefijo de proyecto `observer_` (compartido entre roles,
  # p.ej. observer_python_version definido en observer_python y consumido por
  # observer_api), no el prefijo por-rol que asume esta sub-regla.
  - var-naming[no-role-prefix]
