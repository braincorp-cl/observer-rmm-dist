[Unit]
Description=Celery Beat Service V4
After=network.target redis-server.service postgresql.service

[Service]
Type=simple
User={{ observer_user }}
Group={{ observer_user }}
EnvironmentFile=/etc/conf.d/celery.conf
WorkingDirectory={{ observer_root }}/api/{{ observer_app_name }}
ExecStart=/bin/sh -c '${CELERY_BIN} -A ${CELERY_APP} beat \
    --pidfile=${CELERYBEAT_PID_FILE} \
    --logfile=${CELERYBEAT_LOG_FILE} \
    --loglevel=${CELERYD_LOG_LEVEL}'
ExecStartPre=rm -f {{ observer_root }}/api/{{ observer_app_name }}/beat.pid
ExecStartPre=rm -f {{ observer_root }}/api/{{ observer_app_name }}/celerybeat-schedule
Restart=always
RestartSec=10s

[Install]
WantedBy=multi-user.target
