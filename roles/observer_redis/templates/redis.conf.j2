# redis.conf — generado por Ansible (observer_redis role)

bind {{ observer_redis_bind }}
port {{ observer_redis_port }}
{# El producto (Django channels/cache/celery) se conecta SIN auth, igual que
   el install.sh original — settings.py/local_settings.j2 usan redis://HOST:6379
   sin password. Por eso NO se emite requirepass: la protección es bind a
   loopback + protected-mode + reglas UFW entre grupos (multi-host). Emitir
   requirepass sin parchear el backend para soportar AUTH rompe celery/cache/
   channels con NOAUTH (GAP-033). Ref: redis.conf de producción (install.sh)
   sin requirepass. #}
maxmemory {{ observer_redis_maxmemory }}
maxmemory-policy {{ observer_redis_maxmemory_policy }}

daemonize yes
supervised systemd
loglevel notice
logfile /var/log/redis/redis-server.log

# Persistencia deshabilitada — Redis se usa como broker/cache, no como almacén primario
save ""
appendonly no
