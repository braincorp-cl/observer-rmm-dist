# redis.conf — generado por Ansible (observer_redis role)

bind {{ observer_redis_bind }}
port {{ observer_redis_port }}
{# El producto (Django channels/cache/celery) se conecta SIN auth, igual que
   el install.sh original — settings.py usa redis://HOST:6379 sin password.
   requirepass solo se emite si se define la variable (requeriría además
   parchear settings.py para soportar auth — candidato F009+). En multi-host
   la protección es bind + reglas UFW entre grupos. #}
{% if vault_observer_redis_password is defined and vault_observer_redis_password | length > 0 %}
requirepass {{ vault_observer_redis_password }}
{% endif %}
maxmemory {{ observer_redis_maxmemory }}
maxmemory-policy {{ observer_redis_maxmemory_policy }}

daemonize yes
supervised systemd
loglevel notice
logfile /var/log/redis/redis-server.log

# Persistencia deshabilitada — Redis se usa como broker/cache, no como almacén primario
save ""
appendonly no
