{#
  Reutilizable: install.yml lo renderiza para el frontend principal (sin variables
  extra) y deploy-frontend-preview.yml lo renderiza otra vez por cada dominio de
  observer_app_preview_domains, con _frontend_domain/_frontend_root/_frontend_log.
#}
{% set _fd = _frontend_domain | default(observer_app_domain) %}
{% set _fr = _frontend_root | default('/var/www/observer/dist') %}
{% set _fl = _frontend_log | default('frontend') %}
server {
    server_name {{ _fd }};
    charset utf-8;

    error_log /var/log/nginx/{{ _fl }}-error.log;
    access_log /var/log/nginx/{{ _fl }}-access.log;

    listen 443 ssl;
    listen [::]:443 ssl;
    ssl_certificate {{ observer_cert_path | default('/etc/ssl/observer/fullchain.pem') }};
    ssl_certificate_key {{ observer_cert_key_path | default('/etc/ssl/observer/privkey.pem') }};
    ssl_session_cache shared:FRONTSSL:10m;

    add_header X-Content-Type-Options nosniff;

    # index.html — sin cache (SPA routing, siempre fresco)
    location = /index.html {
        root {{ _fr }};
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        add_header Pragma "no-cache";
    }

    # Assets del agente (binarios de instalación, etc.) — sirve el archivo si existe,
    # pero cae a index.html para la ruta SPA /agents/:agent_id (history mode). Sin este
    # fallback, un deep-link/ventana-nueva a /agents/<id> da 404 (GAP-053): el `alias`
    # previo aliaseaba un dir inexistente y sombreaba la ruta de cliente. `root` (no `alias`)
    # mapea /agents/foo -> <root>/agents/foo igual que antes.
    location /agents/ {
        root {{ _fr }};
        try_files $uri $uri/ /index.html;
        expires 1d;
        add_header Cache-Control "public";
    }

    # JS/CSS/fonts con hash en nombre — inmutables, cache agresivo 30 días
    # Vue/Quasar genera nuevos hashes en cada build → seguro cachear
    location ~* \.(js|css|woff2?|ttf|eot|otf)$ {
        root {{ _fr }};
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Imágenes e iconos
    location ~* \.(png|ico|svg|gif|jpg|jpeg|webp)$ {
        root {{ _fr }};
        expires 7d;
        add_header Cache-Control "public";
        try_files $uri =404;
    }

    # SPA fallback — todas las rutas no coincidentes sirven index.html
    location / {
        root {{ _fr }};
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        add_header Pragma "no-cache";
    }
}

server {
    if ($host = {{ _fd }}) {
        return 301 https://$host$request_uri;
    }
    listen 80;
    listen [::]:80;
    server_name {{ _fd }};
    return 404;
}
