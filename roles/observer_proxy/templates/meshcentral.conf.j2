upstream meshcentral-backend {
    server {{ hostvars[groups['observer_mesh'][0]]['ansible_host'] | default('127.0.0.1') }}:{{ observer_mesh_port | default(4430) }};
}

server {
    listen {{ observer_proxy_https_port }} ssl;
    server_name {{ observer_mesh_domain }};

    ssl_certificate     {{ observer_cert_path }};
    ssl_certificate_key {{ observer_cert_key_path }};
    ssl_protocols       TLSv1.2 TLSv1.3;

    location / {
        # MeshCentral con TLSOffload escucha HTTP plano; nginx termina TLS
        # (= install.sh línea 805 `proxy_pass http://127.0.0.1:4430/`). Interno sin SSL.
        proxy_pass http://meshcentral-backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }
}
