PROD_URL = "https://api.example.com"
DEV_URL = "https://api.example.com"
APP_URL = "https://app.example.com"
DEV_HOST = 0.0.0.0
DEV_PORT = 80
USE_HTTPS = false

# Feature flag: deshabilitación de la UI SSO (BrainCorp 2026-06-01, feature 001-disable-sso-ui).
# Valor "true" oculta toda la superficie SSO en el bundle de build (login, Core Settings, callback).
# Para reactivar SSO en el futuro, asignar "false" y reconstruir con `npm run build`.
# Default seguro: si no se define, el build asume "true" (SSO oculto).
SSO_DISABLED = "true"
