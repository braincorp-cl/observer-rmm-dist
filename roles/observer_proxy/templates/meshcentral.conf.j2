upstream meshcentral-backend {
    server {{ hostvars[groups['observer_mesh'][0]]['ansible_host'] | default('127.0.0.1') }}:{{ observer_mesh_port | default(4430) }};
}

server {
    listen {{ observer_proxy_https_port }} ssl;
    server_name mesh.{{ observer_domain }};

    ssl_certificate     /etc/letsencrypt/live/{{ observer_base_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ observer_base_domain }}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    location / {
        proxy_pass https://meshcentral-backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_verify off;
        proxy_read_timeout 86400;
    }
}
