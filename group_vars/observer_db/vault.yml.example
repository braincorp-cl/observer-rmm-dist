---
# Plantilla de secretos de PostgreSQL — cópiela a vault.yml, reemplace los CHANGEME y
# cifre con `ansible-vault encrypt`.
#   cp group_vars/observer_db/vault.yml.example group_vars/observer_db/vault.yml

# Password del rol PostgreSQL principal (base de datos `observerrmm`).
vault_observer_db_password: "CHANGEME_password_bd_observerrmm"

# Password del rol PostgreSQL de MeshCentral (base de datos `meshcentral`).
# IMPORTANTE: este valor DEBE ser idéntico al vault_observer_mesh_db_password
# definido en group_vars/observer_mesh/vault.yml (el rol observer_db crea el usuario
# y el rol observer_mesh se conecta con la misma credencial).
vault_observer_mesh_db_password: "CHANGEME_password_bd_meshcentral"
