{
  "settings": {
    "cert": "{{ observer_mesh_domain }}",
    "WANonly": true,
    "minify": 1,
    "port": {{ observer_mesh_port | default(4430) }},
    "aliasPort": 443,
    "redirPort": 800,
    "allowLoginToken": true,
    "allowFraming": true,
    "agentPing": 250,
    "agentIdleTimeout": 300,
    "agentWsCompression": true,
    "wsCompression": true,
    "compression": true,
    "allowHighQualityDesktop": true,
    "tlsOffload": "{{ hostvars[groups['observer_proxy'][0]]['ansible_host'] | default('127.0.0.1') }}",
    "cookieEncoding": "base64",
    "agentsInRam": true,
    "allowedFramingOrigins": [
      "https://{{ observer_app_domain }}"
    ],
    "ignoreAgentHashCheck": true,
{#
  autoBackup nativo: DESACTIVADO por defecto (observer_mesh_autobackup_enabled=false).
  - Redundante: observer_backup (GAP-038) ya respalda la DB mesh (pg_dump) + meshcentral-data
    (certs/config) excluyendo node_modules, en cron diario. El nativo no aporta nada nuevo.
  - Recursión: el servicio corre con --dataPath /meshcentral (ver meshcentral.service), y el
    backupPath por defecto cae DENTRO de ese dataPath -> el backup se incluye a sí mismo
    (133M -> 82G -> disco 100%, visto en staging) y al llenar el disco rompía el backup
    diario de observer_backup (tars de 0 bytes). Prod no recursa porque su dataPath es más
    angosto.
  Si se reactiva (observer_mesh_autobackup_enabled=true), backupPath apunta FUERA de
  /meshcentral -> sin recursión posible. Esa es la corrección de la causa raíz.
#}
{% if observer_mesh_autobackup_enabled | bool %}
    "autoBackup": {
      "backupPath": "{{ observer_mesh_autobackup_path }}",
      "keepLastDaysBackup": {{ observer_mesh_autobackup_keep_days | int }},
      "backupHour": {{ observer_mesh_autobackup_hour | int }}
    },
{% else %}
    "autoBackup": false,
{% endif %}
    "prometheus": true,
    "dbExpire": {
      "events": {{ (observer_mesh_events_keep_days | int) * 86400 }},
      "powerevents": {{ (observer_mesh_powerevents_keep_days | int) * 86400 }},
      "statsevents": {{ (observer_mesh_statsevents_keep_days | int) * 86400 }}
    },
    "maxInvalidLogin": {
      "time": 5,
      "count": 5,
      "coolofftime": 30
    },
    "postgres": {
      "user": "{{ observer_mesh_db_user }}",
      "password": "{{ vault_observer_mesh_db_password }}",
      "port": "{{ observer_db_port | default(5432) }}",
      "host": "{{ observer_db_host | default('localhost') }}"
    }
  },
  "domains": {
    "": {
      "title": "Observer RMM",
      "title2": "Observer RMM",
      "newAccounts": false,
      "certUrl": "https://{{ observer_mesh_domain }}:443/",
      "geoLocation": true,
      "cookieIpCheck": false,
      "mstsc": true
    }
  }
}
