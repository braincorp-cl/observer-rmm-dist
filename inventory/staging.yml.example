---
# Plantilla de inventario STAGING — all-in-one sobre un solo host vía SSH.
# Topología co-localizada (los 5 grupos apuntan al mismo host, como all-in-one.yml);
# entre sí los servicios se hablan por loopback DENTRO del host.
#
# USO: copiar a inventory/staging.yml y reemplazar los valores marcados.
#      El archivo real (inventory/staging.yml) está en .gitignore — NO se versiona
#      porque contiene la IP del lab y el admin_url ofuscado del ambiente.
all:
  vars:
    ansible_user: observer
    ansible_python_interpreter: /usr/bin/python3
    observer_db_host: localhost
    observer_redis_host: localhost
    observer_mesh_host: localhost
    observer_nats_host: 127.0.0.1
    # TLS: wildcard *.<base_domain> emitido por acme.sh vía API DNS de GoDaddy (dns_gd),
    # automatizado dentro del playbook (sin paso manual). Requiere vault_godaddy_key/secret
    # en group_vars/observer_proxy/vault.yml. Certs en /etc/ssl/observer/, renovación por cron.
    observer_cert_mode: acme
    observer_acme_email: ops@example.com        # ← email de registro ACME/Let's Encrypt
    # Dominios (install.sh: rmmdomain / frontenddomain / meshdomain / rootdomain):
    observer_domain: api.example.cl             # backend/API — ALLOWED_HOSTS, rmm.conf
    observer_app_domain: rmm.example.cl         # frontend/web UI — frontend.conf, CORS
    observer_mesh_domain: mesh.example.cl       # mesh — meshcentral.conf
    observer_base_domain: example.cl            # dominio raíz para el wildcard *.example.cl
    # URL ofuscada del admin Django (random ~70 chars, como install.sh). Estable por
    # ambiente y única por instalación → definir en un vault, NUNCA en claro aquí.
    observer_admin_url: "{{ vault_admin_url }}" # ← definir en group_vars/observer_api/vault.yml
    # Tuning PostgreSQL para una VM all-in-one chica (~4 GB; los defaults del rol son
    # de prod dedicado: 4GB shared_buffers + huge pages > RAM total). Ajustar a la VM.
    pg_vm_nr_hugepages: 0
    pg_huge_pages: "off"
    pg_shared_buffers: "256MB"
    pg_effective_cache_size: "1GB"
    pg_maintenance_work_mem: "64MB"
    pg_autovacuum_work_mem: "64MB"
    pg_min_wal_size: "128MB"
    pg_max_wal_size: "1GB"
    observer_db_max_connections: 100
  children:
    observer_db:
      hosts:
        staging:
          ansible_host: 10.20.0.10             # ← IP real del host de staging (reemplazar)
    observer_redis:
      hosts:
        staging:
          ansible_host: 10.20.0.10             # ← misma IP (topología co-localizada)
    observer_mesh:
      hosts:
        staging:
          ansible_host: 10.20.0.10
    observer_api:
      hosts:
        staging:
          ansible_host: 10.20.0.10
    observer_proxy:
      hosts:
        staging:
          ansible_host: 10.20.0.10
