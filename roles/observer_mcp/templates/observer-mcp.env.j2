# Gestionado por Ansible (rol observer_mcp). Sin secretos: la credencial llega en
# cada request (Authorization: Bearer <API key de Observer>).
OBSERVER_URL={{ observer_mcp_rest_url }}
OBSERVER_HOST_HEADER={{ observer_mcp_host_header }}
OBSERVER_VERIFY_TLS={{ observer_mcp_verify_tls | bool | lower }}
MCP_PORT={{ observer_mcp_port }}
MCP_ALLOWED_HOSTS={{ observer_mcp_allowed_hosts }}
MCP_ALLOWED_ORIGINS={{ observer_mcp_allowed_origins }}
MCP_MAX_AGENTS={{ observer_mcp_max_agents }}
MCP_RATE_PER_MIN={{ observer_mcp_rate_per_min }}
MCP_MAX_RESPONSE_CHARS={{ observer_mcp_max_response_chars }}
MCP_DISABLED_TOOLS={{ observer_mcp_disabled_tools }}
